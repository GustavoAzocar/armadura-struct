{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openstruct.com.br/contracts/plugins/v1/protocol.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^plugin\\."
        },
        "params": {
          "type": "object"
        }
      },
      "required": ["jsonrpc", "id", "method"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "enum": ["plugin.cancel", "plugin.progress"]
        },
        "params": {
          "type": "object"
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "result": {}
      },
      "required": ["jsonrpc", "id", "result"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "data": {}
          },
          "required": ["code", "message"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "error"],
      "additionalProperties": false
    }
  ]
}
